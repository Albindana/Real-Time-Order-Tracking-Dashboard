{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dashboard.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "dev-only-super-secret-key-min-32-characters!!",
    "Issuer": "RealTimeDashboard",
    "Audience": "DashboardClient",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
